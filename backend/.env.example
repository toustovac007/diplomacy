# Documentation only: Django does not automatically load this file.
# Supply values via PyCharm environment variables or PowerShell/deployment.
DJANGO_DEBUG=true
# Remove ALL POSTGRES_* settings to use the temporary DEBUG-only SQLite fallback.
# Partial PostgreSQL configuration is an error; this file is not auto-loaded.
POSTGRES_DB=diplomacy
POSTGRES_USER=diplomacy
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=0
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_TRUST_X_FORWARDED_PROTO=false
ALLOW_MANUAL_PHASE_RESOLVE=true
FRONTEND_BASE_URL=http://127.0.0.1:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=diplomacie@localhost

# Optional social login. Secrets stay backend-only. See OAUTH.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/users/oauth/google/callback/
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/users/oauth/github/callback/
