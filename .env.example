# Docker Compose reads root .env automatically. Copy this example, then replace
# the placeholder password. Do not commit .env or print resolved Compose config.
# LOCAL DOCKER STACK ONLY; not final production deployment settings.
# Native Django does not load this file. See backend/.env.example and DOCKER.md.
POSTGRES_DB=diplomacy
POSTGRES_USER=diplomacy
POSTGRES_PASSWORD=change-me
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_BASE_URL=http://127.0.0.1:5173
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173

# Optional Google credentials: enter manually in ignored .env, never in VITE_*.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/users/oauth/google/callback/

# Console mail for local validation. No SMTP provider is configured.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=diplomacie@localhost
